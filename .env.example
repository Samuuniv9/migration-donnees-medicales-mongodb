# Copier ce fichier en ".env" puis remplacer chaque mot de passe.
# Le fichier .env n'est JAMAIS envoyé sur GitHub (voir .gitignore).

# Super-administrateur MongoDB (administration du serveur)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changer_moi_root

# Administrateur des données de la base "healthcare" (rôle dbOwner)
MONGO_ADMIN_USER=admin_sante
MONGO_ADMIN_PASSWORD=changer_moi_admin

# Compte du script de migration (rôle readWrite)
MONGO_APP_USER=app_migration
MONGO_APP_PASSWORD=changer_moi_app

# Analyste (rôle read : lecture seule)
MONGO_ANALYST_USER=analyste
MONGO_ANALYST_PASSWORD=changer_moi_analyste

# Dédoublonnage : "false" = migration fidèle (par défaut).
# "true" supprime les lignes identiques : seulement si le client le valide.
DEDUPLICATE=false
